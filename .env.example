# Cloudflare Workers bridge
SERVICE_BRIDGE_WORKER_URL=https://service-bridge-workers.example.workers.dev
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
WORKERS_BRIDGE_TIMEOUT_SECONDS=50

# Private collector sessions. Supply these values through the MCP client's
# secret handling. Alternatively set VAULT_ROOT and use the files beneath
# .codex/tmp/{youtube,x,reddit}/auth/storage-state.json.
YOUTUBE_STORAGE_STATE_JSON=
X_STORAGE_STATE_JSON=
REDDIT_STORAGE_STATE_JSON=

# Private YouTube history cache. Local caching works without AWS. When the
# bucket is configured, use the ambient scoped AWS credentials, not values here.
VAULT_ROOT=/absolute/path/to/english-vault
YOUTUBE_TIMEZONE=Europe/London
YOUTUBE_CACHE_DIR=
YOUTUBE_CACHE_BUCKET=

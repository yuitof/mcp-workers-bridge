# Cloudflare Workers bridge
SERVICE_BRIDGE_WORKER_URL=https://service-bridge-workers.example.workers.dev
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
WORKERS_BRIDGE_TIMEOUT_SECONDS=50

# Optional compatibility path for the existing Lambda/Tailscale client.
# The MCP server invokes this checkout's documented CLI and inherits its AWS,
# VPN, proxy, CA, and cache environment.
LEGACY_BRIDGE_ENABLED=false
VAULT_ROOT=/absolute/path/to/english-vault
SERVICE_BRIDGE_FUNCTION=service-bridge
SERVICE_BRIDGE_TABLE=service-bridge-sessions
LEGACY_BRIDGE_TIMEOUT_SECONDS=180
